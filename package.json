{
  "name": "shopx-elite",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "node -e \"process.env.NODE_ENV='production'; require('./server.js')\"",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify-migration": "node scripts/verifyMigration.js",
    "electron": "set ELECTRON_DEV=1 && electron .",
    "electron:build": "next build && cd electron && npx electron-builder --win --x64 && powershell -Command \"Copy-Item -Path ../dist/ShopX-Elite-Setup.exe -Destination ../public/downloads/ShopX-Elite-Setup.exe -Force\"",
    "electron:pack": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.shopx.elite",
    "productName": "ShopX Elite",
    "copyright": "Copyright © 2024 ShopX Elite",
    "directories": {
      "app": "electron",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ShopX-Elite-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ShopX Elite"
    },
    "asar": true
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.36.0",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@radix-ui/react-visually-hidden": "^1.2.5",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "^8.6.0",
    "genkit": "^1.36.0",
    "lucide-react": "^0.475.0",
    "modules": "^0.4.0",
    "mongoose": "^9.6.3",
    "next": "^16.2.9",
    "next-auth": "^4.24.14",
    "node": "^26.3.0",
    "patch-package": "^8.0.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.1",
    "react-day-picker": "^9.11.3",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.54.2",
    "react-phone-number-input": "^3.4.17",
    "recharts": "^2.15.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/next-auth": "^3.13.0",
    "@types/node": "^20",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
